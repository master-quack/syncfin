# Copy to .env (chmod 600). Never commit .env.

# Passcode needed to browse the library and create rooms (joining a room needs only its code).
PARTY_PASSCODE=
# Random secrets: openssl rand -hex 32
SESSION_SECRET=
INTERNAL_SECRET=

ROOM_SERVER_PORT=3181
ROOM_SERVER_URL=http://127.0.0.1:3181
DB_PATH=./data/party.db

# Dedicated, low-privilege Jellyfin user (see README). Leave the token blank to use the mock library.
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_TOKEN=
JELLYFIN_USER_ID=
# Address viewers' browsers use to reach Jellyfin. Blank = same as JELLYFIN_URL.
JELLYFIN_PUBLIC_URL=
# Only titles under this folder (and present on disk) are listed. Blank = everything Jellyfin lists.
LIBRARY_ROOT=

# Browser-reachable WebSocket URL of the room server. Blank = wss://<this host>/ws.
WS_PUBLIC_URL=

# Optional policy switches
# DIRECT_PLAY_CONTAINERS=mp4,m4v,mov,webm
# DIRECT_PLAY_VIDEO=h264,hevc
# DIRECT_PLAY_AUDIO=aac,mp3,opus,vorbis,flac
# ALLOW_REMUX=true            # play MKV via Jellyfin's live remux (video copied, never re-encoded)
# ALLOW_AUDIO_CONVERT=false   # also allow AC3/EAC3 audio, converted to AAC by Jellyfin
